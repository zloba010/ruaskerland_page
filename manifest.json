{
  "manifest_version": 3,
  "name": "RuAskerland New Tab",
  "version": "1.0",
  "description": "This extension replaces the new tab page with a custom page.",
  "key": "",
  "permissions": [
    "notifications",
    "tabs"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "assets/Icoon.png",
    "48": "assets/Icoon.png",
    "128": "assets/Icoon.png"
  },
  "action": {
    "default_icon": "assets/Icoon.png",
    "default_popup": "popup.html"
  },
  "homepage_url": "https://ruaskerland/privacy-policy"
}